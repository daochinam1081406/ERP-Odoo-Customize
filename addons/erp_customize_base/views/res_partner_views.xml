<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kế thừa form danh bạ gốc của Odoo (base.view_partner_form), chèn
         thêm một trường ngay sau ô Email — không sửa view gốc. -->
    <record id="view_partner_form_inherit_erp_customize" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.erp.customize</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="internal_reference"/>
            </xpath>
        </field>
    </record>
</odoo>
