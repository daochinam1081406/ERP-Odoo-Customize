<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_demo_item_list" model="ir.ui.view">
        <field name="name">erp.customize.demo.item.list</field>
        <field name="model">erp.customize.demo.item</field>
        <field name="arch" type="xml">
            <list string="Demo Items">
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_demo_item_form" model="ir.ui.view">
        <field name="name">erp.customize.demo.item.form</field>
        <field name="model">erp.customize.demo.item</field>
        <field name="arch" type="xml">
            <form string="Demo Item">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_demo_item" model="ir.actions.act_window">
        <field name="name">Demo Items</field>
        <field name="res_model">erp.customize.demo.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_erp_customize_root" name="ERP Customize"/>
    <menuitem id="menu_demo_item" name="Demo Items"
              parent="menu_erp_customize_root"
              action="action_demo_item"/>
</odoo>
